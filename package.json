{
  "name": "vantra-maturity-check",
  "version": "0.1.0",
  "private": true,
  "description": "Self-assessment tool that scores design-system maturity across documentation, versioning, governance and adoption — as an interactive CLI and as a static web app.",
  "license": "MIT",
  "author": "Vantra Design <hello@vantra.design>",
  "homepage": "https://github.com/vantradesign/vantra-maturity-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantradesign/vantra-maturity-check.git"
  },
  "bugs": {
    "url": "https://github.com/vantradesign/vantra-maturity-check/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm --filter @vantra-design/maturity-core build && pnpm --filter @vantra-design/maturity-check build",
    "build:web": "pnpm --filter @vantra-design/maturity-web build",
    "dev:web": "pnpm --filter @vantra-design/maturity-web dev",
    "cli": "pnpm --filter @vantra-design/maturity-check start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run build && pnpm -r --parallel run typecheck",
    "test": "pnpm run build && pnpm -r run test",
    "test:unit": "pnpm --filter @vantra-design/maturity-core test",
    "test:e2e": "pnpm run build && pnpm --filter @vantra-design/maturity-check test",
    "test:coverage": "pnpm --filter @vantra-design/maturity-core test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && node scripts/publish.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm --filter @vantra-design/maturity-check test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
