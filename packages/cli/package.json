{
  "name": "@vantra-design/maturity-check",
  "version": "0.1.0",
  "description": "Interactive CLI that scores your design system across documentation, versioning, governance and adoption, and hands back prioritised next steps.",
  "keywords": [
    "design-system",
    "maturity",
    "assessment",
    "cli",
    "governance",
    "self-assessment"
  ],
  "license": "MIT",
  "author": "Vantra Design <hello@vantra.design>",
  "homepage": "https://github.com/vantradesign/vantra-maturity-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantradesign/vantra-maturity-check.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "vantra-maturity-check": "./dist/index.js",
    "vmc": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vantra-design/maturity-core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
