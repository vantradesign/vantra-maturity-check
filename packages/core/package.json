{
  "name": "@vantra-design/maturity-core",
  "version": "0.1.0",
  "description": "Framework-agnostic assessment engine, question catalog and scoring logic behind the Vantra Maturity Check.",
  "keywords": [
    "design-system",
    "maturity-model",
    "assessment",
    "governance",
    "self-assessment"
  ],
  "license": "MIT",
  "author": "Vantra Design <vantra@kauper.co>",
  "homepage": "https://github.com/vantradesign/vantra-maturity-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantradesign/vantra-maturity-check.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema/catalog.schema.json": "./schema/catalog.schema.json",
    "./schema/questions.schema.json": "./schema/questions.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
