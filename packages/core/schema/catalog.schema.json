{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantra.design/schema/vantra-maturity/catalog.schema.json",
  "title": "Vantra Maturity catalog",
  "description": "A complete, assembled assessment catalog. This is the shape `loadCatalog()` accepts, so any domain (design systems, API governance, content ops) can be assessed without code changes.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver of the content. A major bump means stored results are no longer comparable."
    },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["en", "de"] }
    },
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/level" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "nextSteps": {
      "type": "object",
      "description": "categoryId -> level (\"1\"–\"5\") -> ordered list of at least three steps.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "1": { "$ref": "#/$defs/stepList" },
          "2": { "$ref": "#/$defs/stepList" },
          "3": { "$ref": "#/$defs/stepList" },
          "4": { "$ref": "#/$defs/stepList" },
          "5": { "$ref": "#/$defs/stepList" }
        },
        "required": ["1", "2", "3", "4", "5"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "locales",
    "levels",
    "categories",
    "nextSteps"
  ],
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      },
      "required": ["en", "de"],
      "additionalProperties": { "type": "string" }
    },
    "level": {
      "type": "object",
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "minScore": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "description": "Inclusive lower bound. The highest level whose bound is reached wins."
        },
        "name": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" }
      },
      "required": ["level", "id", "minScore", "name", "summary"],
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "questions": {
          "$ref": "https://vantra.design/schema/vantra-maturity/questions.schema.json"
        }
      },
      "required": ["id", "name", "description", "questions"],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "effort": {
          "enum": ["S", "M", "L"],
          "description": "S = days, M = weeks, L = a quarter."
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "detail": { "$ref": "#/$defs/localizedText" }
      },
      "required": ["id", "effort", "title", "detail"],
      "additionalProperties": false
    },
    "stepList": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/step" }
    }
  }
}
