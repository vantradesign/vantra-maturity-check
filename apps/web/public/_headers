# Security headers for Cloudflare Pages.
#
# `nuxt generate` copies public/ verbatim into the output root, which is where
# Pages looks for this file. Verify against the deployed response.
#
# This app has a stronger claim to make than most: the intro page states that
# nothing leaves the browser. `connect-src 'self'` and `form-action 'none'` make
# that structural rather than merely true — a script that tried to post answers
# somewhere would be blocked by the browser, not just absent from the source.
#
# `style-src 'unsafe-inline'`: ScoreRadar and ScoreTable bind bar widths through
# :style, which is inline style by construction. Values are derived from the
# scoring engine, never from user text.
#
# `script-src 'self'`: Nuxt emits one inline script per page assigning
# window.__NUXT__.config. `scripts/inject-csp-hashes.mjs` runs as part of
# `pnpm build` and appends its sha256 to the policy in the GENERATED copy of this
# file. Do not add a hash here by hand — it embeds a per-build id and would be
# wrong on the next build.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
